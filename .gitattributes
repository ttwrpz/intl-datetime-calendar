# Line endings are normalised to LF everywhere. The coding standard requires
# LF in PHP files, and the committed browser bundles are compared byte for byte
# against a fresh build, so a Windows checkout converting to CRLF makes both
# the standards check and the build drift check fail on a clean tree.
* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.dist text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.svg text eol=lf

# Keep the release archive free of development files.
/.github export-ignore
/tests export-ignore
/js/src export-ignore
/build.mjs export-ignore
/.distignore export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/README.md export-ignore
